{
  "name": "@nlabs/alfred",
  "version": "1.0.0",
  "description": "A living AI assistant shell with app-supplied knowledge and connectivity.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "docs/assets"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.css": "./lib/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrogenlabs/alfred.git"
  },
  "homepage": "https://alfred.nitrogenx.co",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "lex compile --remove --config tsconfig.build.json && node scripts/assets.mjs",
    "lint": "lex lint --maxWarnings 0",
    "prepublishOnly": "npm test && npm run build",
    "publish:major": "npm version major && npm run publish:tags && npm publish",
    "publish:minor": "npm version minor && npm run publish:tags && npm publish",
    "publish:patch": "npm version patch && npm run publish:tags && npm publish",
    "publish:tags": "git push --tags && git push origin HEAD",
    "start": "npm run start --prefix examples/basic",
    "test": "lex test --unit",
    "test:e2e": "lex test --e2e",
    "typecheck": "tsc --noEmit",
    "update": "lex update --interactive",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@nlabs/arkhamjs": "^3.31.16",
    "@nlabs/arkhamjs-utils-react": "^3.32.13",
    "@nlabs/gothamui": "^1.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@nlabs/arkhamjs": "3.31.16",
    "@nlabs/arkhamjs-utils-react": "3.32.13",
    "@nlabs/gothamui": "1.11.2",
    "@nlabs/lex": "2.0.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
